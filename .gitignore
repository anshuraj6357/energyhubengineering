!.env.example
!frontend/.env.example
!backend/.env.example

# =========================
# Build Output
# =========================
dist/
build/
frontend/dist/
backend/dist/

# =========================
# Logs
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

